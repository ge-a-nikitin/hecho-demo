# Production configuration without secrets.
#
# The deploy workflow concatenates this file and the PROD_ENV_SECRETS GitHub
# secret into .env on the server, so never put secrets here:
#   cat deploy/prod.env > .env && printf '%s\n' "$PROD_ENV_SECRETS" >> .env
#
# Plain `docker compose ...` commands pick both compose files up via COMPOSE_FILE.

DOMAIN=hecho-demo.spb.su

# The tunnel route points at localhost:8080, so the web container is published there.
WEB_PORT=8080

# Cloudflare edge -> cloudflared -> nginx forward the protocol and the client IP.
TRUST_PROXY=true

# Devtools can wipe all data, so they stay off in production.
DEVTOOLS_ENABLED=false

COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

POSTGRES_USER=order_desk
POSTGRES_DB=order_desk

ADMIN_EMAIL=admin@example.com

S3_ACCESS_KEY=order-desk
S3_BUCKET=order-files

SEAWEEDFS_ADMIN_USER=admin
