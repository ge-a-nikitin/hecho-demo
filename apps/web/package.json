{
  "name": "@order-desk/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:qase": "QASE_MODE=testops vitest run",
    "typecheck": "tsc -b --pretty && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^18.0.10",
    "jsdom": "^31.0.1",
    "typescript": "6.0.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0",
    "vitest-qase-reporter": "^1.7.0"
  }
}
