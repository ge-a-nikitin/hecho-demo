# Copy this file to .env and replace the placeholder passwords for local use.
POSTGRES_USER=order_desk
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=order_desk
POSTGRES_PORT=6202
DATABASE_URL=postgresql://order_desk:replace-this-local-password@localhost:6202/order_desk?schema=public
WEB_PORT=6200
API_PORT=6201
S3_PORT=6203
SEAWEEDFS_ADMIN_PORT=6204
VITE_API_URL=http://localhost:6201/api
FRONTEND_ORIGIN=http://localhost:6200
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-this-admin-password
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:6201/api/auth
DEVTOOLS_ENABLED=false
DEVTOOLS_API_KEY=replace-this-with-a-random-devtools-key
DEVTOOLS_SEED_PASSWORD=replace-this-with-a-local-test-account-password

S3_ACCESS_KEY=order-desk
S3_SECRET_KEY=replace-this-s3-password
S3_BUCKET=order-files
S3_ENDPOINT=http://localhost:6203

SEAWEEDFS_ADMIN_USER=admin
SEAWEEDFS_ADMIN_PASSWORD=replace-this-admin-password
