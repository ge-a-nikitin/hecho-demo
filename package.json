{
  "name": "order-desk",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "db:format": "pnpm --filter @order-desk/api db:format",
    "db:validate": "pnpm --filter @order-desk/api db:validate",
    "db:generate": "pnpm --filter @order-desk/api db:generate",
    "db:migrate": "pnpm --filter @order-desk/api db:migrate",
    "db:migrate:status": "pnpm --filter @order-desk/api db:migrate:status",
    "db:sync:admin": "pnpm --filter @order-desk/api db:sync:admin",
    "db:reset": "pnpm --filter @order-desk/api db:reset",
    "qase:sync": "pnpm --filter @order-desk/api qase:sync",
    "qase:run": "pnpm qase:sync && pnpm --filter @order-desk/api test:qase"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
